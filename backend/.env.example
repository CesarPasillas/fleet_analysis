# ML model artifacts (paths relative to backend/)
MODEL_PATH=app/ml/artifacts/route_model.keras
MODEL_METADATA_PATH=app/ml/artifacts/metadata.json
DEFAULT_TRAINING_DATA=data/route_geometry_training_batch.csv

# CORS - frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Input data paths (relative to backend/)
# POS files: use DIR + GLOB_PATTERN, or override with DATA_POS_GLOB for a custom path
DATA_POS_DIR=data/pos
DATA_POS_GLOB_PATTERN=pos*.csv
# DATA_POS_GLOB=data/pos/pos*.csv

DATA_EVENTTYPE_CSV=data/EventType.csv
DATA_CARRETERAS_GLOB=data/carreteras*.csv
